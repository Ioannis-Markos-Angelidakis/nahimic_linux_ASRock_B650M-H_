 DATA = Path(os.environ.get("XDG_DATA_HOME", Path.home() / ".local/share")) / "nahimic-linux"
 RUNTIME = DATA / "runtime"
+SHARE = Path("/usr/share/nahimic-linux")
 sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "host"))
 from desktop_audio import atomic_json, pulse
 
@@ -18,6 +19,21 @@ PROFILES = {
     "Communication": ("通话", "77f18420-d6b9-11e7-8f1a-0800200c9a66"),
 }
 
+# Vendor equalizer preset files name the ten bands the way the Windows Nahimic3
+# panel does; the audio engine settings use their own band centres.
+EQ_BANDS = (
+    ("EQ32HzGainDB", "kSet_EQ31HzGainDB"),
+    ("EQ64HzGainDB", "kSet_EQ62HzGainDB"),
+    ("EQ125HzGainDB", "kSet_EQ125HzGainDB"),
+    ("EQ250HzGainDB", "kSet_EQ250HzGainDB"),
+    ("EQ500HzGainDB", "kSet_EQ500HzGainDB"),
+    ("EQ1kHzGainDB", "kSet_EQ1kHzGainDB"),
+    ("EQ2kHzGainDB", "kSet_EQ2kHzGainDB"),
+    ("EQ4kHzGainDB", "kSet_EQ4kHzGainDB"),
+    ("EQ8kHzGainDB", "kSet_EQ8kHzGainDB"),
+    ("EQ16kHzGainDB", "kSet_EQ16kHzGainDB"),
+)
+
 
 class Backend:
     def control(self, *args):
@@ -58,6 +74,34 @@ class Backend:
             raise RuntimeError("音效参数未生效")
         return state
 
+    def set_settings(self, values):
+        arguments = []
+        for name, value in values.items():
+            arguments.extend((name, str(value)))
+        self.control("--set-settings", *arguments)
+        state = self.settings()
+        for name, value in values.items():
+            if abs(state["settings"][name]["value"] - float(value)) > 1e-5:
+                raise RuntimeError("音效参数未生效")
+        return state
+
+    def eq_presets(self):
+        presets = {}
+        directory = SHARE / "eqpresets"
+        if not directory.is_dir():
+            return presets
+        for profile in sorted(path.name for path in directory.iterdir() if path.is_dir()):
+            entries = []
+            for path in sorted((directory / profile).glob("*.json")):
+                data = json.loads(path.read_text())
+                values = {setting: float(data[source]) for source, setting in EQ_BANDS
+                          if source in data}
+                if len(values) == len(EQ_BANDS):
+                    entries.append((path.stem, values))
+            if entries:
+                presets[profile] = entries
+        return presets
+
     def profile(self, name):
         self.control("--global-profile", "{" + PROFILES[name][1] + "}")
         state = self.settings()
