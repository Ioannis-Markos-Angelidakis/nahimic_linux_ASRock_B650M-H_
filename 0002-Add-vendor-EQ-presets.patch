+class EqPresetUiTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls): cls.app = QApplication.instance() or QApplication([])
+    def setUp(self):
+        presets = {'Music': [('Heavy Bass', {name: value for name, value in zip(BAND_SETTINGS, HEAVY_BASS)}),
+                             ('Dynamic', {name: value for name, value in zip(BAND_SETTINGS, DYNAMIC)}),
+                             ('Custom', {name: value for name, value in zip(BAND_SETTINGS, FLAT)})],
+                   'Gaming': [('Fast-paced', {name: value for name, value in zip(BAND_SETTINGS, (-6, -1, 3, 1, 0, 0, 1, 5, 6, 5))})]}
+        self.audio = PresetAudioBackend(presets)
+        with patch('main.Backend', lambda: self.audio), patch('main.ThreadPoolExecutor', ManualExecutor):
+            self.panel = Panel()
+        p = self.panel; p.timer.stop(); p.status_timer.stop()
+        for name in p.values:
+            p.backend.data['settings'][name] = {'min': -12, 'max': 12, 'value': 0}
+        for name in p.switches:
+            p.backend.data['settings'][name] = {'min': 0, 'max': 1, 'value': 1}
+        self.drain()
+    def tearDown(self):
+        self.panel.busy_timer.stop(); self.panel.close(); self.panel.deleteLater()
+    def finish(self, result=None):
+        p = self.panel; future = p.pending[0]
+        try: future.set_result(p.pool.calls.pop(future)() if result is None else result)
+        except Exception as error: future.set_exception(error)
+        p.poll()
+    def drain(self):
+        for _ in range(20):
+            if self.panel.pending is None: return
+            self.finish()
+        self.fail('queue failed to settle')
+    def edit_band(self, value, key='kSet_EQ31HzGainDB'):
+        slider = self.panel.values[key]; slider.setValue(value); slider.sliderReleased.emit()
+
+    def test_preset_click_writes_all_ten_bands_and_selects_the_chip(self):
+        p = self.panel
+        self.assertFalse(p.eq_preset_buttons[('Music', 'Heavy Bass')].isHidden())
+        self.assertTrue(p.eq_preset_buttons[('Music', 'Custom')].isChecked())  # flat curve
+        p.eq_preset_buttons[('Music', 'Heavy Bass')].click()
+        for name, value in zip(BAND_SETTINGS, HEAVY_BASS):
+            self.assertEqual(p.values[name].value(), value)
+        self.drain()
+        self.assertEqual(p.backend.writes, list(zip(BAND_SETTINGS, HEAVY_BASS)))
+        self.assertTrue(p.eq_preset_buttons[('Music', 'Heavy Bass')].isChecked())
+        self.assertFalse(p.eq_preset_buttons[('Music', 'Custom')].isChecked())
+
+    def test_rapid_preset_clicks_coalesce_to_the_last_choice(self):
+        p = self.panel
+        p.eq_preset_buttons[('Music', 'Heavy Bass')].click()
+        p.eq_preset_buttons[('Music', 'Dynamic')].click()
+        p.eq_preset_buttons[('Music', 'Heavy Bass')].click()
+        self.assertEqual(len(p.jobs), 1)
+        self.finish()
+        self.assertEqual(len(p.backend.writes), 10)  # the in-flight write ran once
+        self.drain()
+        self.assertEqual(p.backend.writes, list(zip(BAND_SETTINGS, HEAVY_BASS)) * 2)
+        self.assertTrue(p.eq_preset_buttons[('Music', 'Heavy Bass')].isChecked())
+
+    def test_manual_edit_switches_the_selection_back_to_custom(self):
+        p = self.panel
+        p.eq_preset_buttons[('Music', 'Heavy Bass')].click()
+        self.drain()
+        self.edit_band(4)
+        self.drain()
+        self.assertEqual(p.values['kSet_EQ31HzGainDB'].value(), 4)
+        self.assertTrue(p.eq_preset_buttons[('Music', 'Custom')].isChecked())
+        self.assertFalse(p.eq_preset_buttons[('Music', 'Heavy Bass')].isChecked())
+
+    def test_profile_switch_swaps_the_visible_chips(self):
+        p = self.panel
+        self.assertTrue(p.eq_preset_buttons[('Gaming', 'Fast-paced')].isHidden())
+        p.modes['Gaming'].click()
+        self.drain()
+        self.assertFalse(p.eq_preset_buttons[('Gaming', 'Fast-paced')].isHidden())
+        self.assertTrue(p.eq_preset_buttons[('Music', 'Heavy Bass')].isHidden())
+
+    def test_stale_preset_click_after_a_queued_profile_switch_is_discarded(self):
+        p = self.panel
+        p.modes['Gaming'].click()
+        p.eq_preset_buttons[('Music', 'Heavy Bass')].click()
+        self.assertEqual(p.pending[2], 'profile')
+        self.drain()
+        self.assertEqual(p.backend.data['profile'], 'Gaming')
+        self.assertEqual(p.backend.writes, [])  # nothing written into the new profile
+        self.assertFalse(p.eq_preset_buttons[('Gaming', 'Fast-paced')].isHidden())
+
+    def test_failed_preset_is_read_back_and_the_error_stays_visible(self):
+        p = self.panel
+        p.backend.reject = 'kSet_EQ31HzGainDB'
+        p.eq_preset_buttons[('Music', 'Heavy Bass')].click()
+        self.drain()
+        self.assertIn('device rejected write', p.status.text())
+        self.assertEqual(p.values['kSet_EQ31HzGainDB'].value(), 0)
+        self.assertTrue(p.controls.isEnabled())
+        p.refresh(); self.drain()
+        self.assertIn('device rejected write', p.status.text())
+
+
+if __name__ == '__main__': unittest.main()
