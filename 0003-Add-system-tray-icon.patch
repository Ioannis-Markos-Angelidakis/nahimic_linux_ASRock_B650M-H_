+    def refresh_texts(self):
+        self.translations.bind(self.toggle_action, 'text',
+                               '隐藏 Nahimic' if self.panel.isVisible() else '打开 Nahimic')
+        self.translations.bind(self.quit_action, 'text', '退出 Nahimic')
+
+    def activated_reason(self, reason):
+        if reason in (QSystemTrayIcon.Trigger, QSystemTrayIcon.DoubleClick):
+            self.toggle_panel()
+
+    def toggle_panel(self):
+        if self.panel.isVisible():
+            self.panel.hide()
+        else:
+            self.panel.showNormal(); self.panel.raise_(); self.panel.activateWindow()
+        self.refresh_texts()
+
+
+def tray_available():
+    return QSystemTrayIcon.isSystemTrayAvailable()
+
+
+def tray_needs_xwayland(platform, environment):
+    """Whether the panel should retry under XWayland so Plasma can host its icon.
+
+    Qt's system tray speaks the XEmbed protocol, which native Wayland windows
+    cannot join; Plasma Wayland bridges XEmbed icons into its tray through
+    xembed-sni-proxy. One restart with the xcb platform is therefore enough on
+    Plasma, while other desktops stay on their native platform.
+    """
+    if platform != 'wayland':
+        return False
+    if not environment.get('WAYLAND_DISPLAY'):
+        return False
+    if environment.get('NAHIMIC_TRAY') == '0':
+        return False
+    if environment.get('QT_QPA_PLATFORM') or environment.get('NAHIMIC_TRAY_XCB'):
+        return False
+    session = (environment.get('XDG_CURRENT_DESKTOP') or '') + ':' + (environment.get('XDG_SESSION_DESKTOP') or '')
+    return 'KDE' in session.upper()
+
