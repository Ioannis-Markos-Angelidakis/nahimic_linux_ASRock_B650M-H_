index 0000000..194a49b
--- /dev/null
+++ b/tests/test_tray.py
@@ -0,0 +1,129 @@
+"""System tray icon: menu labels, hide-to-tray, activation and the Wayland retry."""
+import copy
+from concurrent.futures import Future
+import os
+from pathlib import Path
+import sys
+import unittest
+from unittest.mock import patch
+
+os.environ.setdefault('QT_QPA_PLATFORM', 'offscreen')
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'app'))
+from PySide6.QtWidgets import QApplication, QSystemTrayIcon
+import main
+from main import Panel, tray_needs_xwayland
+
+
+class ManualExecutor:
+    def __init__(self, **kwargs): self.calls = {}
+    def submit(self, function):
+        future = Future(); self.calls[future] = function; return future
+    def shutdown(self, **kwargs): pass
+
+
+class AudioBackend:
+    def __init__(self):
+        self.data = {'profile':'Music', 'settings':{}}
+        self.state = {'ready':True,'service':'active','autostart':True,'instance':1,
+                      'enabled':True,'active':True,'volume':50,'muted':False}
+    def status(self): return copy.deepcopy(self.state)
+    def settings(self): return copy.deepcopy(self.data)
+    def eq_presets(self): return {}
+    def set_setting(self, key, value):
+        self.data['settings'][key]['value'] = value
+        return self.settings()
+    def set_settings(self, values):
+        for key, value in values.items():
+            self.data['settings'][key]['value'] = value
+        return self.settings()
+    def profile(self, value):
+        self.data['profile']=value
+        return self.settings()
+    def mute(self, value): self.state['muted']=value
+    def volume(self, value): self.state['volume']=value
+    def enabled(self, value): self.state['enabled']=value
+    def autostart(self, value): self.state['autostart']=value
+
+
+class TrayIconTest(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls): cls.app=QApplication.instance() or QApplication([])
+    def setUp(self):
+        with patch('main.Backend', AudioBackend), patch('main.ThreadPoolExecutor', ManualExecutor), \
+             patch('main.tray_available', lambda: True):
+            self.panel = Panel()
+        p=self.panel;p.timer.stop();p.status_timer.stop()
+        for name in p.values:
+            p.backend.data['settings'][name]={'min':-12,'max':12,'value':0}
+        for name in p.switches:
+            p.backend.data['settings'][name]={'min':0,'max':1,'value':1}
+    def tearDown(self):
+        p=self.panel;p.busy_timer.stop();p.close();p.deleteLater()
+
+    def test_menu_carries_translated_actions(self):
+        p=self.panel
+        self.assertIsNotNone(p.tray)
+        self.assertEqual(p.tray.toggle_action.text(), p.translations.text('打开 Nahimic'))
+        self.assertEqual(p.tray.quit_action.text(), p.translations.text('退出 Nahimic'))
+        self.assertEqual(p.tray.toolTip(), p.translations.text('Nahimic 音效'))
+
+    def test_closing_hides_to_the_tray_instead_of_quitting(self):
+        p=self.panel
+        self.assertFalse(QApplication.instance().quitOnLastWindowClosed())
+        self.assertFalse(p.close())
+        self.assertTrue(p.isHidden())
+        self.assertEqual(p.tray.toggle_action.text(), p.translations.text('打开 Nahimic'))
+
+    def test_tray_click_toggles_the_window(self):
+        p=self.panel;p.hide()
+        p.tray.activated.emit(QSystemTrayIcon.Trigger)
+        self.assertTrue(p.isVisible())
+        self.assertEqual(p.tray.toggle_action.text(), p.translations.text('隐藏 Nahimic'))
+        p.tray.activated.emit(QSystemTrayIcon.DoubleClick)
+        self.assertTrue(p.isHidden())
+        self.assertEqual(p.tray.toggle_action.text(), p.translations.text('打开 Nahimic'))
+
+    def test_quit_action_quits_the_application(self):
+        with patch('main.QApplication') as application:
+            with patch('main.Backend', AudioBackend), patch('main.ThreadPoolExecutor', ManualExecutor), \
+                 patch('main.tray_available', lambda: True):
+                panel = Panel()
+            panel.tray.quit_action.trigger()
+            application.instance().quit.assert_called_once()
+            panel.busy_timer.stop();panel.close();panel.deleteLater()
+
+    def test_closing_without_a_tray_closes_the_window(self):
+        with patch('main.Backend', AudioBackend), patch('main.ThreadPoolExecutor', ManualExecutor):
+            panel = Panel()
+        self.assertIsNone(panel.tray)
+        self.assertTrue(panel.close())
