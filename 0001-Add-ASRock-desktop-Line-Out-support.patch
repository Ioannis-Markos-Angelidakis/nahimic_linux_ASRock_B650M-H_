+class AsrockLineOutTest(unittest.TestCase):
+    def sink(self, port='analog-output-lineout', components='HDA:10ec0897,18491897,00100402'):
+        return {'active_port': port, 'properties': {'alsa.components': components},
+                'ports': [{'name': 'analog-output-headphones', 'type': 'Headphones',
+                           'availability': 'not available'}]}
+
+    def test_exact_lineout_uses_asrock_external_profile(self):
+        from desktop_audio import runtime_files, asrock_line_out
+        sink = self.sink()
+        self.assertTrue(asrock_line_out(sink))
+        self.assertTrue(supported_speaker(sink, []))
+        self.assertEqual(device_settings(sink), 'Generic_ExternalSpeakers.nsx')
+        self.assertEqual(runtime_files(sink), ('vendor/NahimicAPO4.dll',
+                         'vendor/NahimicAPO4API.dll', 'factory-asrock'))
+
+    def test_lineout_port_names_and_inf_subsystems(self):
+        for port in ('analog-output-speaker', '[Out] Line Out', '[Out] Speaker'):
+            self.assertTrue(supported_speaker(self.sink(port), []), port)
+        for subsystem in ('18492897', '18496899', '18498899'):
+            self.assertTrue(supported_speaker(
+                self.sink(components=f'HDA:10ec0897,{subsystem},00100402'), []), subsystem)
+        for subsystem in ('18492229', '1849222a', '1849222b', '1849222c', '1849222d'):
+            self.assertTrue(supported_speaker(
+                self.sink(components=f'HDA:10ec1220,{subsystem},00100101'), []), subsystem)
+
+    def test_headphones_and_other_vendors_are_excluded(self):
+        self.assertFalse(supported_speaker(self.sink('analog-output-headphones'), []))
+        self.assertFalse(supported_speaker(self.sink(components='HDA:10ec0897,10438356,00100402'), []))
+        sink = self.sink()
+        sink['ports'][0]['availability'] = 'available'
+        self.assertFalse(supported_speaker(sink, []))
+
+    def test_untyped_headphone_port_name_still_bypasses(self):
+        # Path-configured HDA cards may omit the port type; the port name
+        # identifies the jack when its availability reports a connection.
+        sink = self.sink()
+        sink['ports'] = [{'name': 'analog-output-headphones', 'availability': 'available'}]
+        self.assertFalse(supported_speaker(sink, []))
